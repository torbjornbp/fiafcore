@prefix fiaf: <https://dev.fiafcore.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.fiafcore.org/732fce4e-9738-4501-bc5f-f9243db387af>
    a fiaf:Item ;
    rdfs:label "Metropolis Item" ;
    fiaf:hasBase fiaf:PolyesterBase ;
    fiaf:hasColourCharacteristic [ a fiaf:BlackAndWhite ] ;
    fiaf:hasFormat fiaf:35mmFilm ;
    fiaf:hasHoldingInstitution
        <https://example.fiafcore.org/f0032f62-d28c-4730-a358-afb8106173e0> ;
    fiaf:hasIdentifier [ a fiaf:Identifier ;
        fiaf:hasIdentifierAuthority
            <https://example.fiafcore.org/f0032f62-d28c-4730-a358-afb8106173e0> ;
        fiaf:hasIdentifierValue "482874" ] ;
    fiaf:hasLanguageUsage [ a fiaf:Intertitles ;
            fiaf:hasLanguage fiaf:German ] ;
    fiaf:hasSoundCharacteristic [ a fiaf:Silent ] ;
    fiaf:hasStatus fiaf:Preservation ;
    fiaf:hasStock [ a fiaf:Agfa ] ;
    fiaf:isElement fiaf:ReleasePrint .

# A multi-reel print: a group Item with one component Item per reel held.
# Each reel carries its own description; nothing is inherited from the group.

<https://example.fiafcore.org/multi-reel-print>
    a fiaf:Item ;
    rdfs:label "Release print, 2 reels" ;
    fiaf:isElement fiaf:ReleasePrint ;
    fiaf:hasFormat fiaf:35mmFilm ;
    fiaf:hasExtent [ a fiaf:Reel ; fiaf:hasExtentValue "2" ] ;
    fiaf:hasComponent
        <https://example.fiafcore.org/multi-reel-print-reel-1> ,
        <https://example.fiafcore.org/multi-reel-print-reel-2> .

<https://example.fiafcore.org/multi-reel-print-reel-1>
    a fiaf:Item ;
    rdfs:label "Reel 1" ;
    fiaf:hasBase fiaf:NitrateBase ;
    fiaf:hasExtent [ a fiaf:Metre ; fiaf:hasExtentValue "310" ] .

<https://example.fiafcore.org/multi-reel-print-reel-2>
    a fiaf:Item ;
    rdfs:label "Reel 2 (later safety replacement)" ;
    fiaf:hasBase fiaf:AcetateBase ;
    fiaf:hasExtent [ a fiaf:Metre ; fiaf:hasExtentValue "295" ] .

<https://example.fiafcore.org/tinted-item>
    a fiaf:Item ;
    rdfs:label "Tinted Item Example" ;
    fiaf:hasColourCharacteristic [ a fiaf:BlackAndWhiteWithAppliedColour ; fiaf:hasColourProcess fiaf:Tinted ] .
