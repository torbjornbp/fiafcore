    rdfs:label "Duplicate Positive"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmElement> ;
.

<https://dev.fiafcore.org/FilmElement> a owl:Class ;
    dc:description "An Element of a photochemical film item, whatever its polarity or support."@en ;
    rdfs:label "Film"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/Element> ;
.

<https://dev.fiafcore.org/HomeViewingCopy> a owl:Class ;
    dc:description "A copy distributed for home viewing, on any carrier, including videotape, optical disc or digital."@en ;
    rdfs:label "Home Viewing Copy"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/VideoElement> ;
.

<https://dev.fiafcore.org/MagneticElement> a owl:Class ;
    dc:description "An Element whose image or sound is fixed magnetically rather than photochemically."@en ;
    rdfs:label "Magnetic"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmElement> ;
.

<https://dev.fiafcore.org/Negative> a owl:Class ;
    dc:description "A negative Element of unspecified generation."@en ;
