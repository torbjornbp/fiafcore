    rdfs:subClassOf <https://dev.fiafcore.org/FilmElement> ;
.

<https://dev.fiafcore.org/ReversalPositive> a owl:Class ;
    dc:description "An original positive produced by reversal processing, without an intervening negative."@en ;
    rdfs:label "Reversal Positive"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/FilmElement> ;
.

<https://dev.fiafcore.org/SoundNegative> a owl:Class ;
