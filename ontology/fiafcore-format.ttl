PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://dev.fiafcore.org/Format> a owl:Class ;
    rdfs:label "Format"@en ;
    dc:description "The physical medium, digital file format, or deliverable package in which a moving image Manifestation, Item, or Carrier is fixed. Digital stream encodings are described separately with hasVideoCodec or hasAudioCodec."@en ;
    dc:source <> ;
.

