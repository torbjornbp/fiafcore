    dc:description "A defined deliverable package combining image, audio, and metadata files, rather than a single file container."@en ;
    dc:source <> ;
    rdfs:label "Package Format"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/DigitalFormat> ;
.

<https://dev.fiafcore.org/DCDM> a owl:Class ;
    dc:description "The Digital Cinema Distribution Master: an uncompressed master comprising image, audio, and subtitle files defined by SMPTE ST 428."@en ;
    dc:source <> ;
    rdfs:label "DCDM"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/PackageFormat> ;
.

<https://dev.fiafcore.org/DCP> a owl:Class ;
    dc:description "A Digital Cinema Package as defined by SMPTE or Interop, comprising a composition playlist, packing list, asset map, and MXF tracks."@en ;
    dc:source <> ;
    rdfs:label "DCP"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/PackageFormat> ;
.

<https://dev.fiafcore.org/IMF> a owl:Class ;
    dc:description "An Interoperable Master Format package as defined by SMPTE ST 2067."@en ;
    dc:source <> ;
    rdfs:label "IMF"@en ;
    rdfs:subClassOf <https://dev.fiafcore.org/PackageFormat> ;
.

