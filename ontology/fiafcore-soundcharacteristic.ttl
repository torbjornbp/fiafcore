PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

### Class

<https://dev.fiafcore.org/SoundCharacteristic> a owl:Class ;
    rdfs:label "Sound Characteristic"@en ;
    dc:description "The presence and nature of sound on a single soundtrack of a Manifestation or Item. A carrier with several soundtracks carries several SoundCharacteristic nodes."@en ;
    dc:source <> ;
.

### Subclasses

<https://dev.fiafcore.org/Mute> a owl:Class ;
    rdfs:label "Mute"@en ;
    dc:description "An image-only element, or a print whose soundtrack area is intentionally absent or masked, produced in the sound era."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/SoundCharacteristic> ;
.

<https://dev.fiafcore.org/Silent> a owl:Class ;
    rdfs:label "Silent"@en ;
    dc:description "A film produced without recorded sound, or a print intended for silent exhibition."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/SoundCharacteristic> ;
.

<https://dev.fiafcore.org/Sound> a owl:Class ;
    rdfs:label "Sound"@en ;
    dc:description "Sound is present on the soundtrack."@en ;
    dc:source <> ;
    rdfs:subClassOf <https://dev.fiafcore.org/SoundCharacteristic> ;
.

### Datatype Properties

# None

### Object Properties

<https://dev.fiafcore.org/hasNoiseReduction>
    a owl:ObjectProperty ;
    rdfs:label "Has Noise Reduction"@en ;
    dc:description "Express the analogue companding noise-reduction system applied to a sound recording."@en ;
    dc:source <> ;
    rdfs:domain <https://dev.fiafcore.org/SoundCharacteristic> ;
    rdfs:range <https://dev.fiafcore.org/NoiseReduction> ;
.

<https://dev.fiafcore.org/hasSoundChannelConfiguration>
    a owl:ObjectProperty ;
    rdfs:label "Has Sound Channel Configuration"@en ;
    dc:description "Express the channel configuration of the sound in a Manifestation or Item."@en ;
    dc:source <> ;
    rdfs:domain <https://dev.fiafcore.org/SoundCharacteristic> ;
    rdfs:range <https://dev.fiafcore.org/SoundChannelConfiguration> ;
.

<https://dev.fiafcore.org/hasSoundStandard>
    a owl:ObjectProperty ;
    rdfs:label "Has Sound Standard"@en ;
    dc:description "Express a sound fixation process or playback/encoding system. Noise reduction is expressed separately with hasNoiseReduction."@en ;
    dc:source <> ;
    rdfs:domain <https://dev.fiafcore.org/SoundCharacteristic> ;
    rdfs:range <https://dev.fiafcore.org/SoundStandard> ;
.
